<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/quick_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#F1F5F9"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/quick_band_down"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="6dp"
            android:text="Band-"
            android:textColor="#E5A823"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/quick_band_up"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="6dp"
            android:text="Band+"
            android:textColor="#E5A823"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/quick_mode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="6dp"
            android:text="Mode"
            android:textColor="#E5A823"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/quick_vol_down"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="6dp"
            android:text="Vol-"
            android:textColor="#E5A823"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/quick_vol_up"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="6dp"
            android:text="Vol+"
            android:textColor="#E5A823"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/quick_att"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingBottom="4dp"
            android:text="ATT"
            android:textColor="#E5A823"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/quick_pre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingBottom="4dp"
            android:text="PRE"
            android:textColor="#E5A823"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/quick_nb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingBottom="4dp"
            android:text="NB"
            android:textColor="#E5A823"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/quick_nr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingBottom="4dp"
            android:text="NR"
            android:textColor="#E5A823"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
